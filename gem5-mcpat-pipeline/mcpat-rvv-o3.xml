<!--
  template_ooo_riscv.xml

  A McPAT 1.3 input file for gem5's RiscvO3CPU (out-of-order model).
  Built by taking template_inorder_riscv.xml and turning on the
  out-of-order structures McPAT supports (ROB, register renaming,
  separate int/fp issue queues, physical register files distinct from
  architectural ones) that the in-order template deliberately zeroed
  out. This is the third leg of the CPU-architecture comparison
  discussed previously: MinorCPU (in-order) vs. O3CPU (this file) vs.
  U74/RISCVMatchedBoard (template_u74_riscv.xml).

  IMPORTANT  -  READ BEFORE YOUR FIRST RUN:
  The widths, ROB size, and queue sizes below are McPAT-side numbers
  that need to match whatever RiscvO3CPU actually simulated. Unlike
  the in-order template, this is NOT free to leave at generic
  placeholders  -  an out-of-order core's power and area are highly
  sensitive to ROB/issue-queue/physical-register-file sizing, and
  McPAT has no way to check your input against what gem5 actually ran.
  Before trusting this file's output, get the REAL sizes gem5 used:

      python3 -c "
      from m5.objects import RiscvO3CPU as C
      for p in ['fetchWidth','decodeWidth','issueWidth','commitWidth',
                'numROBEntries','numIQEntries','LQEntries','SQEntries',
                'numPhysIntRegs','numPhysFloatRegs']:
          print(p, getattr(C, p).default)
      "

  Then replace every value below marked "GEM5 O3CPU DEFAULT  -  VERIFY"
  with what that prints for your actual gem5 checkout. These defaults
  have changed across gem5 versions and are NOT tuned to VeeR EH1, U74,
  or any other specific chip  -  they are gem5's own generic choices.
  Do not report this file's numbers as reflecting your target core's
  real architecture; report them as "gem5's default O3CPU model,"
  full stop, same distinction your se_config.py docstring already makes.

  Two things this file does NOT attempt:
    - SMT/multithreading structures (galmorph-rvs4 is single-threaded).
    - A branch predictor sized to O3CPU specifically  -  kept the same
      placeholder as your other templates; O3CPU's default predictor
      in gem5 is more elaborate (tournament-style) than what's modeled
      here. If precision on branch-predictor power matters to your
      report, this is the next thing to fix, not this file's ROB/issue
      structures.
-->
<component id="root" name="root">
  <component id="system" name="system">
    <param name="number_of_cores" value="1"/>
    <param name="number_of_L1Directories" value="0"/>
    <param name="number_of_L2Directories" value="0"/>
    <param name="number_of_L2s" value="1"/>
    <param name="number_of_L3s" value="0"/>
    <param name="number_of_NoCs" value="0"/>
    <param name="homogeneous_cores" value="1"/>
    <param name="homogeneous_L2s" value="1"/>
    <param name="homogeneous_L1Directories" value="0"/>
    <param name="homogeneous_L2Directories" value="0"/>
    <param name="homogeneous_L3s" value="0"/>
    <param name="homogeneous_ccs" value="1"/>
    <param name="homogeneous_NoCs" value="0"/>
    <!-- STATIC ASSUMPTION: same stand-in as your other templates, so the -->
    <!-- three architectures are at least comparable on process node. -->
    <!-- Change all three templates together if you change this. -->
    <param name="core_tech_node" value="22"/>
    <param name="target_core_clockrate" value="100"/>
    <param name="temperature" value="340"/>
    <param name="number_cache_levels" value="2"/>
    <param name="interconnect_projection_type" value="0"/>
    <!-- STATIC ASSUMPTION: kept at 1 (low standby power) to match your -->
    <!-- other templates  -  this is about the process/library choice, -->
    <!-- not about in-order vs out-of-order, so there's no reason for -->
    <!-- it to differ across the three architecture comparisons. -->
    <param name="device_type" value="1"/>
    <param name="longer_channel_device" value="1"/>
    <param name="power_gating" value="0"/>
    <param name="machine_bits" value="32"/>
    <param name="virtual_address_width" value="32"/>
    <param name="physical_address_width" value="32"/>
    <param name="virtual_memory_page_size" value="4096"/>
    <stat name="total_cycles" value="9218764"/>
    <stat name="idle_cycles" value="0"/>
    <stat name="busy_cycles" value="9218764"/>

    <component id="system.core0" name="core0">
      <param name="clock_rate" value="100"/>
      <param name="opt_local" value="0"/>
      <param name="instruction_length" value="32"/>
      <param name="opcode_width" value="7"/>
      <param name="x86" value="0"/>
      <param name="micro_opcode_width" value="8"/>
      <!-- machine_type: 0 = out-of-order. This is the one param that -->
      <!-- MUST differ from your in-order templates  -  McPAT reads this -->
      <!-- to decide which structural model (ROB/rename/issue-queue vs. -->
      <!-- simple in-order pipe) to apply to everything below. -->
      <param name="machine_type" value="0"/>
      <param name="number_hardware_threads" value="1"/>
      <!-- CONFIRMED against real gem5 25.1.0.1 (Ahsan's checkout): -->
      <!-- fetchWidth=8. -->
      <param name="fetch_width" value="8"/>
      <param name="number_instruction_fetch_ports" value="1"/>
      <!-- CONFIRMED: decodeWidth=8. -->
      <param name="decode_width" value="8"/>
      <!-- CONFIRMED: issueWidth=8. -->
      <param name="issue_width" value="8"/>
      <param name="peak_issue_width" value="8"/>
      <!-- CONFIRMED: commitWidth=8. -->
      <param name="commit_width" value="8"/>
      <param name="fp_issue_width" value="4"/>
      <param name="prediction_width" value="1"/>
      <!-- STATIC ASSUMPTION: O3CPU's pipeline depth isn't a single -->
      <!-- gem5 parameter the way width/ROB-size are - it emerges from -->
      <!-- how many pipeline stages you configure (IEW delay, etc). 14 -->
      <!-- is a placeholder in the range typical of general-purpose OoO -->
      <!-- cores (see the deep-review doc's POWER7/Nehalem/K10 table for -->
      <!-- real comparables at 12-17 stages) - not read from gem5, and -->
      <!-- not checked against this gem5 version (no single param to -->
      <!-- check it against - would need to sum stage-delay params). -->
      <param name="pipeline_depth" value="14,14"/>
      <param name="ALU_per_core" value="2"/>
      <param name="MUL_per_core" value="1"/>
      <param name="FPU_per_core" value="2"/>
      <param name="instruction_buffer_size" value="32"/>
      <param name="decoded_stream_buffer_size" value="16"/>
      <!-- instruction_window_scheme: 0 = physicalRegFile-based (McPAT's -->
      <!-- name for the modern OoO issue-queue model); required for OoO. -->
      <param name="instruction_window_scheme" value="0"/>
      <!-- STILL UNVERIFIED: "numIQEntries" is not a real attribute on -->
      <!-- gem5 25.1.0.1's RiscvO3CPU (confirmed via AttributeError when -->
      <!-- checked directly) - this gem5 version splits IQ sizing some -->
      <!-- other way (per-class entries, most likely, given the separate -->
      <!-- int/fp/vec instruction queues your real O3 stats.txt showed - -->
      <!-- see gem5_to_mcpat.py's OoO STAT_MAP comments). 64 below is -->
      <!-- still a placeholder, not confirmed against anything. -->
      <param name="instruction_window_size" value="64"/>
      <param name="fp_instruction_window_size" value="32"/>
      <!-- CONFIRMED: numROBEntries=192. This is the single most -->
      <!-- consequential number in this file - ROB size drives a large -->
      <!-- fraction of an OoO core's modeled area/power, and this gap -->
      <!-- from MinorCPU's ROB-free design is most of why O3's reported -->
      <!-- power comes out far higher - a real difference in what's -->
      <!-- being modeled, not a bug. -->
      <param name="ROB_size" value="192"/>
      <param name="archi_Regs_IRF_size" value="32"/>
      <param name="archi_Regs_FRF_size" value="32"/>
      <!-- CONFIRMED: numPhysIntRegs=256 (previously had this at 128, -->
      <!-- half the real value - fixed). Physical > architectural is -->
      <!-- what makes this an OoO register file. -->
      <param name="phy_Regs_IRF_size" value="256"/>
      <!-- CONFIRMED: numPhysFloatRegs=256 (same fix). -->
      <param name="phy_Regs_FRF_size" value="256"/>
      <!-- rename_scheme: 0 = RAM-based (McPAT default for a physical- -->
      <!-- register-file OoO design, matches instruction_window_scheme above). -->
      <param name="rename_scheme" value="0"/>
      <param name="register_windows_size" value="0"/>
      <!-- LSU_order: MUST be "outoforder" here - this is the second -->
      <!-- param, besides machine_type, that actually switches McPAT's -->
      <!-- internal model. Leaving this as "inorder" while machine_type=0 -->
      <!-- is an internally inconsistent config McPAT may not catch for you. -->
      <param name="LSU_order" value="outoforder"/>
      <!-- CONFIRMED: SQEntries=32, matches. -->
      <param name="store_buffer_size" value="32"/>
      <!-- CONFIRMED: LQEntries=32, matches. -->
      <param name="load_buffer_size" value="32"/>
      <param name="memory_ports" value="2"/>
      <param name="RAS_size" value="16"/>
      <param name="fetch_throughput" value="8"/>

      <stat name="total_instructions" value="19862361"/>
      <stat name="int_instructions" value="9931180.500000"/>
      <stat name="fp_instructions" value="9931180.500000"/>
      <stat name="branch_instructions" value="1179583"/>
      <stat name="branch_mispredictions" value="1733"/>
      <stat name="load_instructions" value="6646543"/>
      <stat name="store_instructions" value="2249184"/>
      <stat name="committed_instructions" value="19862361"/>
      <stat name="committed_int_instructions" value="9931180.500000"/>
      <stat name="committed_fp_instructions" value="9931180.500000"/>
      <stat name="pipeline_duty_cycle" value="1"/>
      <stat name="total_cycles" value="9218764"/>
      <stat name="idle_cycles" value="0"/>
      <stat name="busy_cycles" value="9218764"/>
      <!-- These four ROB/rename stats are the actual reason this file -->
      <!-- exists separately from the in-order template  -  an in-order -->
      <!-- core genuinely has zero here, an OoO core does not, and -->
      <!-- gem5_to_mcpat.py's OOO_STAT_MAP additions (see the patched -->
      <!-- converter script) now try several real gem5 O3CPU stat-name -->
      <!-- candidates for these before falling back to an estimate. -->
      <!-- Confirm with scripts/find_stats.sh on your real O3 stats.txt. -->
      <stat name="ROB_reads" value="27585379"/>
      <stat name="ROB_writes" value="39809719"/>
      <stat name="rename_reads" value="13049914"/>
      <stat name="rename_writes" value="17374402"/>
      <stat name="fp_rename_reads" value="4714076"/>
      <stat name="fp_rename_writes" value="19918464"/>
      <stat name="inst_window_reads" value="17556325"/>
      <stat name="inst_window_writes" value="4164040"/>
      <stat name="inst_window_wakeup_accesses" value="4145690"/>
      <stat name="fp_inst_window_reads" value="7117051"/>
      <stat name="fp_inst_window_writes" value="3405685"/>
      <stat name="fp_inst_window_wakeup_accesses" value="3365866"/>
      <stat name="int_regfile_reads" value="19862361"/>
      <stat name="int_regfile_writes" value="9931180.500000"/>
      <stat name="float_regfile_reads" value="19862361"/>
      <stat name="float_regfile_writes" value="9931180.500000"/>
      <stat name="function_calls" value="0"/>
      <stat name="context_switches" value="0"/>
      <stat name="ialu_accesses" value="9931180.500000"/>
      <stat name="fpu_accesses" value="9931180.500000"/>
      <stat name="mul_accesses" value="0"/>
      <stat name="cdb_alu_accesses" value="9931180.500000"/>
      <stat name="cdb_mul_accesses" value="0"/>
      <stat name="cdb_fpu_accesses" value="9931180.500000"/>

      <component id="system.core0.predictor" name="PBT">
        <!-- STATIC ASSUMPTION: same placeholder as your other templates. -->
        <!-- gem5's actual default O3CPU branch predictor is more -->
        <!-- elaborate (tournament/TAGE-class depending on version)  -  -->
        <!-- this under-models it the same way it under-models your -->
        <!-- in-order templates' predictor, just flagging it again here -->
        <!-- since it matters more at 8-wide speculative fetch. -->
        <param name="local_predictor_size" value="10,3"/>
        <param name="local_predictor_entries" value="1024"/>
        <param name="global_predictor_entries" value="0"/>
        <param name="global_predictor_bits" value="2"/>
        <param name="chooser_predictor_entries" value="0"/>
        <param name="chooser_predictor_bits" value="2"/>
        <stat name="predictor_accesses" value="1179583"/>
      </component>

      <component id="system.core0.itlb" name="itlb">
        <param name="number_entries" value="32"/>
        <stat name="total_accesses" value="19862361"/>
        <stat name="total_misses" value="0"/>
        <stat name="conflicts" value="0"/>
      </component>

      <component id="system.core0.icache" name="icache">
        <param name="icache_config" value="16384,32,2,1,1,3,32,0"/>
        <param name="buffer_sizes" value="4,4,4,0"/>
        <stat name="read_accesses" value="1544284"/>
        <stat name="read_misses" value="159"/>
        <stat name="conflicts" value="0"/>
      </component>

      <component id="system.core0.dtlb" name="dtlb">
        <param name="number_entries" value="32"/>
        <stat name="total_accesses" value="8895727"/>
        <stat name="total_misses" value="0"/>
        <stat name="conflicts" value="0"/>
      </component>

      <component id="system.core0.dcache" name="dcache">
        <param name="dcache_config" value="16384,32,2,1,1,3,32,0"/>
        <param name="buffer_sizes" value="4,4,4,4"/>
        <stat name="read_accesses" value="6646543"/>
        <stat name="write_accesses" value="2249184"/>
        <stat name="read_misses" value="139498"/>
        <stat name="write_misses" value="105770"/>
        <stat name="conflicts" value="0"/>
      </component>

      <component id="system.core0.BTB" name="BTB">
        <param name="BTB_config" value="2048,4,2,1,1,3"/>
        <stat name="read_accesses" value="1179583"/>
        <stat name="write_accesses" value="1733"/>
      </component>
    </component>
    <component id="system.L20" name="L20">
      <!-- McPAT's parser walks system's children by POSITION, not by
           name. With 1 core and zero L2/L3/NoC/directories, its
           position counter never moves off 0, so it re-reads
           system.core0 when it goes looking for system.mc next,
           which is the "number_of_cores/.../NoCs is/are not correct"
           error. There is no XML-only way to skip this; one small,
           mostly-idle L2 is the standard workaround. It does add a
           small, real amount of area/leakage to the total, not
           exactly zero: check this component's own line in the
           print_level 5 output if you want a strictly core-only
           number. -->
      <param name="L2_config" value="2048,32,1,1,1,3,32,0"/>
      <param name="clockrate" value="100"/>
      <param name="vdd" value="0"/>
      <param name="merged_dir" value="0"/>
      <param name="ports" value="1,1,1"/>
      <param name="device_type" value="0"/>
      <param name="threeD_stack" value="0"/>
      <param name="buffer_sizes" value="1,1,1,1"/>
      <stat name="total_accesses" value="1"/>
      <stat name="read_accesses" value="1"/>
      <stat name="write_accesses" value="0"/>
      <stat name="total_hits" value="1"/>
      <stat name="total_misses" value="0"/>
      <stat name="read_hits" value="1"/>
      <stat name="write_hits" value="0"/>
      <stat name="read_misses" value="0"/>
      <stat name="write_misses" value="0"/>
      <stat name="replacements" value="0"/>
      <stat name="write_backs" value="0"/>
      <stat name="miss_buffer_accesses" value="0"/>
      <stat name="fill_buffer_accesses" value="0"/>
      <stat name="prefetch_buffer_accesses" value="0"/>
      <stat name="prefetch_buffer_writes" value="0"/>
      <stat name="prefetch_buffer_reads" value="0"/>
      <stat name="wbb_writes" value="0"/>
      <stat name="wbb_reads" value="0"/>
      <stat name="conflicts" value="0"/>
      <stat name="duty_cycle" value="0.0001"/>
    </component>
    <component id="system.mc" name="mc">
      <param name="type" value="0"/>
      <param name="mc_clock" value="200"/>
      <param name="vdd" value="0"/>
      <param name="peak_transfer_rate" value="3200"/>
      <param name="block_size" value="64"/>
      <param name="number_mcs" value="0"/>
      <param name="memory_channels_per_mc" value="1"/>
      <param name="number_ranks" value="2"/>
      <param name="withPHY" value="0"/>
      <param name="req_window_size_per_channel" value="32"/>
      <param name="IO_buffer_size_per_channel" value="32"/>
      <param name="databus_width" value="128"/>
      <param name="addressbus_width" value="51"/>
      <stat name="memory_accesses" value="0"/>
      <stat name="memory_reads" value="0"/>
      <stat name="memory_writes" value="0"/>
    </component>

    <component id="system.niu" name="niu">
      <param name="type" value="0"/>
      <param name="clockrate" value="350"/>
      <param name="vdd" value="0"/>
      <param name="number_units" value="0"/>
      <stat name="duty_cycle" value="1.0"/>
      <stat name="total_load_perc" value="0.7"/>
    </component>

    <component id="system.pcie" name="pcie">
      <param name="type" value="0"/>
      <param name="withPHY" value="1"/>
      <param name="clockrate" value="350"/>
      <param name="vdd" value="0"/>
      <param name="number_units" value="0"/>
      <param name="num_channels" value="8"/>
      <stat name="duty_cycle" value="1.0"/>
      <stat name="total_load_perc" value="0.7"/>
    </component>

    <component id="system.flashc" name="flashc">
      <param name="number_flashcs" value="0"/>
      <param name="type" value="1"/>
      <param name="vdd" value="0"/>
      <param name="withPHY" value="1"/>
      <param name="peak_transfer_rate" value="200"/>
      <stat name="duty_cycle" value="1.0"/>
      <stat name="total_load_perc" value="0.7"/>
    </component>

  </component>
</component>
